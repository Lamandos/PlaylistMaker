<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yp_light_gray"
    android:orientation="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playlist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".player.ui.fragments.PlayerFragment">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="0dp" />

            <ImageView
            android:id="@+id/playlistCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tint="@color/yp_black"
            android:src="@drawable/back_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/playlistTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:gravity="start"
            style="@style/playlist_title"
            app:layout_constraintEnd_toEndOf="@+id/playlistCover"
            app:layout_constraintStart_toStartOf="@+id/playlistCover"
            app:layout_constraintTop_toBottomOf="@id/playlistCover" />

        <TextView
            android:id="@+id/playlistDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            style="@style/playlist_description"
            app:layout_constraintEnd_toEndOf="@+id/playlistTitle"
            app:layout_constraintStart_toStartOf="@+id/playlistTitle"
            app:layout_constraintTop_toBottomOf="@id/playlistTitle" />

        <LinearLayout
            android:id="@+id/totalTimeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@+id/playlistDescription"
            app:layout_constraintTop_toBottomOf="@id/playlistDescription">

            <TextView
                android:id="@+id/playlistTotalTime"
                style="@style/playlist_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"/>

            <ImageView
                android:id="@+id/dot"
                app:tint="@color/yp_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/dot" />

            <TextView
                android:id="@+id/tracksTotal"
                style="@style/playlist_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@+id/playlistDescription"
            app:layout_constraintTop_toBottomOf="@id/totalTimeCount">

            <ImageView
                android:id="@+id/share"
                app:tint="@color/yp_black"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/share_icon" />

            <ImageView
                android:id="@+id/more"
                app:tint="@color/yp_black"
                android:layout_marginStart="16dp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/more_btn"
                android:scaleType="centerInside"
                />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/tracks_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        app:behavior_hideable="false"
        app:behavior_peekHeight="266dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <View
                android:id="@+id/line"
                android:layout_width="50dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bottom_sheet_line"/>
            <ImageView
                android:id="@+id/tracks_no_results_image"
                style="@style/NoResultsImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:visibility="gone"/>
            <TextView
                style="@style/search_error"
                android:id="@+id/tracks_no_results_message"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone"
                android:text="@string/no_tracks" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlist_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>

    <View android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"/>


    <LinearLayout
        android:id="@+id/playlist_menu"
        android:layout_width="match_parent"
        android:layout_height="383dp"
        android:orientation="vertical"
        app:behavior_hideable="true"
        android:background="@drawable/bg_bottom_sheet"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bottom_sheet_line"/>
        <FrameLayout
            android:id="@+id/playlist_pop_container"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:paddingStart="3dp"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:id="@+id/playlist_share"
            android:layout_width="match_parent"
            android:layout_height="61dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/share_playlist"
            android:paddingStart="16dp"
            android:textColor="@color/bottom_nav_text_inactive"
            android:textSize="19sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/playlist_edit"
            android:layout_width="match_parent"
            android:layout_height="61dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/change_data"
                android:paddingStart="16dp"
                android:textColor="@color/bottom_nav_text_inactive"
                android:textSize="19sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/playlist_delete"
            android:layout_width="match_parent"
            android:layout_height="61dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/delete_playlist"
                android:paddingStart="16dp"
                android:textColor="@color/bottom_nav_text_inactive"
                android:textSize="19sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>